# Copie para .env e preencha com os valores do seu projeto.
# O .env está no .gitignore — NUNCA comite valores reais neste arquivo.

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=cole_aqui_a_publishable_key
# Só no servidor / Edge Functions. Nunca no front-end, nunca no repositório.
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_secret_key

# --- Cron da Vercel (rota /api/assinaturas/gerar) ---
# Obrigatório: sem ele a rota responde 401 e as diárias de assinatura não são
# geradas. A rota também precisa da SUPABASE_SERVICE_ROLE_KEY acima.
CRON_SECRET=

# --- Edge Functions ---
ALLOWED_ORIGIN=http://localhost:3000

# --- Gateway de pagamento (Stripe) ---
# Chave secreta: só no servidor, nunca com prefixo NEXT_PUBLIC_. Cole no
# Vercel (Project Settings > Environment Variables), nunca aqui neste
# arquivo com valor real nem em nenhuma conversa/chat.
STRIPE_SECRET_KEY=
# Chave publicável: essa sim pode ir para o navegador — é feita para isso.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard da Stripe > Developers > Webhooks > Add endpoint, apontando
# para https://SEU_DOMINIO/api/webhooks/stripe, eventos:
#   checkout.session.completed, checkout.session.async_payment_succeeded
# A Stripe mostra esse valor (whsec_...) na hora que o endpoint é criado.
STRIPE_WEBHOOK_SECRET=

# --- Geocodificação (CEP -> lat/lng para o matching) ---
GEOCODING_API_KEY=
