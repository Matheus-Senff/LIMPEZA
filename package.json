{
  "name": "limpeza",
  "version": "0.1.0",
  "private": true,
  "description": "Plano Limpo — plataforma de serviços residenciais",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=plano-limpo-web",
    "build": "npm run build --workspace=plano-limpo-web",
    "start": "npm run start --workspace=plano-limpo-web",
    "test": "npm test --workspace=@limpeza/pricing && npm test --workspace=plano-limpo-web",
    "sync:pricing": "node scripts/sync-pricing.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
